<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>32.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>Mutants.Android</RootNamespace>
    <AssemblyName>Mutants.Android</AssemblyName>
    <AndroidManifest>AndroidManifest.xml</AndroidManifest>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <AndroidUseAapt2>true</AndroidUseAapt2>
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <!-- Keep debug APKs self-contained so they can be installed with adb. -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mutants.Game\Mutants.Game.csproj" />
    <PackageReference Include="MonoGame.Framework.Android" Version="$(MonoGameVersion)" />
  </ItemGroup>

  <ItemGroup>
    <AndroidResource Include="Resources\**\*" />
  </ItemGroup>

</Project>
